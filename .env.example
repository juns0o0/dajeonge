# 복사해서 .env 로 쓴다. 비우면 MOCK 모드(외부 API 없이 규칙 응답)로 동작한다.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# 운영 전 반드시 바꿀 것
ADMIN_TOKEN=change-me-admin-token
PASSWORD_SALT=change-me-random-salt

# 기본은 SQLite 파일. PostgreSQL 예: postgresql+psycopg://user:pw@host:5432/dajeong
DATABASE_URL=sqlite:///./data/dajeong.db
AUDIO_DIR=./data/audio
CORS_ORIGINS=*
RUN_JOBS=1
